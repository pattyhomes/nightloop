{
  "name": "nightloop-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "dev:local": "npm run dev",
    "dev:watch": "npm run dev",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/server.js",
    "ingest:ra": "tsx src/scripts/fetchRAEvents.ts",
    "enrich:foursquare": "tsx src/scripts/enrichVenuesFoursquare.ts",
    "review:google-qa": "tsx src/scripts/reviewGooglePlacesQa.ts",
    "import:sf-notable": "tsx src/scripts/importSfNotableVenues.ts",
    "audit:venue-provenance": "tsx src/scripts/auditVenueProvenance.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "@types/pg": "^8.18.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.2",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.5"
  }
}
