# Runtime environment
NODE_ENV=development

# HTTP port for backend server (local demo API on /api/recommendations)
PORT=4000

# Supabase-backed Phase 1 API.
# Use the Session Pooler Postgres URI for local development.
DATABASE_URL=
SUPABASE_PROJECT_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated browser origins allowed to call the backend.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Keep legacy /api prototype routes available outside production.
LEGACY_ROUTES_ENABLED=true

# Protected write rate limits.
RATE_LIMIT_WINDOW_MS=60000
SIGNAL_WRITE_LIMIT=12
ACCOUNT_WRITE_LIMIT=30

# Dev/test only: pin recommendation scoring to a fixed point in time.
# Omit (or leave unset) for normal runtime — real current time is used by default.
# NIGHTLOOP_FIXED_NOW=2026-03-09T04:00:00.000Z

# App Store reviewer seed gate. Backend-only.
# REVIEWER_AUTH_USER_ID=

# ── Provider import gates ────────────────────────────────────────────────────
# Foursquare Places API v3. Backend-only. Live ops imports are capped to 20 venues.
# Obtain at: https://foursquare.com/developers/app
# Scope needed: "Places" (read-only access to place search and place details).
# Never commit the real key.
# FOURSQUARE_API_KEY=your_api_key_here

# Google Places is planned for the gated Phase 2B venue data provider.
# Keep this backend-only; do not expose it in NEXT_PUBLIC_* or the iOS app.
# GOOGLE_PLACES_API_KEY=your_api_key_here

# Resident Advisor automated ingestion is disabled by default and blocked in production.
# Enable only for approved local/licensed testing.
# ENABLE_RA_DEV_IMPORT=false
